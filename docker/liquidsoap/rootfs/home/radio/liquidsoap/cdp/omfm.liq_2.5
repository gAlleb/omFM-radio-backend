def check(r)
  #log.critical(label="request.uri","#{request.uri(r)}")
  if request.resolve(r) then
    m = request.metadata(r)

    if l.last(m) < 3600. then
    log(level=3,"Rejecting #{m['artist']} (played #{l.last(m)}s ago).")
      false
    else
      l.add(m)
      next_title := m["title"]
      next_artist := m["artist"]
      next_playlist := m["playlist"]
      next_album := m["album"]
      true
    end
  else
    false
  end
end

