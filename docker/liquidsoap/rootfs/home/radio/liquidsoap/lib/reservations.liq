# Отложенные кандидаты: кто зазвучит следующим у каждого источника.
#
# Нужна тем станциям, которые объявляют следующий трек. Liquidsoap выбирает
# кандидата заранее, но держит его внутри плейлиста — вытащить можно только
# из check_next, поэтому источник кладёт принятого сюда, а расписание потом
# спрашивает по имени.

# Отложенные кандидаты — очередь на каждую категорию.
#
# Одной ячейки мало: когда до категории доходит очередь, она отдаёт в эфир
# припасённый трек и тут же выбирает следующий. В этот момент у неё в воздухе
# сразу два кандидата, и «последний принятый» — это уже трек через один.
# Поэтому держим очередь и снимаем с неё трек, когда он вышел в эфир: головой
# очереди тогда всегда оказывается настоящий следующий.
pending = ref([])

def queue_of(name) =
  list.assoc(default=[], name, pending())
end

def set_queue(name, q) =
  pending := list.add((name, q), list.assoc.remove(name, pending()))
end

# С 2.5 резолвы запросов и обработчики метаданных идут параллельно на разных
# ядрах, а здесь и там — чтение-изменение-запись одного и того же `pending`.
# Без atomic это тихая потеря кандидата, а не ошибка, поэтому каждая такая
# последовательность собрана в одну секцию.
def remember_next(name, m)
  atomic({set_queue(name, list.append(queue_of(name), [m]))})
end

# Хвост очереди после трека, который только что отзвучал. Вызывается только
# когда трек действительно найден: сам по себе этот обход не отличает
# «трека нет» от «нужно выбросить всю очередь».
def rec after_aired(q, aired) =
  if q == [] then
    []
  else
    head = list.hd(default=[], q)
    rest = list.tl(q)
    name = head["filename"]
    if name == aired then rest else after_aired(rest, aired) end
  end
end

# Трек вышел в эфир — выбрасываем его и всё, что стояло перед ним.
#
# Событие метаданных может прийти повторно. В частности, fallback.skip после
# джингла сначала переигрывает метаданные прерванного трека, которого в
# резервации уже нет. Такая запись не должна очищать настоящих следующих
# кандидатов. Неизвестные очереди (джинглы, emergency) тоже не создаём.
# Решение и правка очереди — одна секция atomic; строка в лог пишется уже после
# неё, чтобы в секции не оказалось ввода-вывода.
def drop_aired(m) =
  name = m["playlist"]
  aired = m["filename"]

  def decide() =
    if name != "" and list.assoc.mem(name, pending()) then
      q = queue_of(name)
      if list.exists(fun (candidate) -> candidate["filename"] == aired, q) then
        set_queue(name, after_aired(q, aired))
        true
      else
        false
      end
    else
      true
    end
  end

  if not atomic(decide) then
    log(level=4, "reservations: повторные метаданные #{name}: #{aired}, очередь сохраняю")
  end
end

def reservation(name) =
  list.hd(default=[], queue_of(name))
end
