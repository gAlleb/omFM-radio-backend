# ============================================================
#  omFM stack — реальные значения. НЕ коммитится (см. .gitignore)
#  Шаблон для репозитория: .env.example
# ============================================================

# --- Icecast ---
ICECAST_HOSTNAME=CHANGE_ME
ICECAST_ADMIN_USERNAME=CHANGE_ME
ICECAST_SOURCE_PASSWORD=CHANGE_ME
ICECAST_ADMIN_PASSWORD=CHANGE_ME
ICECAST_RELAY_PASSWORD=CHANGE_ME

# --- omfmapi: HTTP Basic, которым к нему стучатся Liquidsoap и listeners_monitor ---
OMFMAPI_USER=CHANGE_ME
OMFMAPI_PASSWORD=CHANGE_ME

# --- Centrifugo ---
CENTRIFUGO_API_KEY=CHANGE_ME
CENTRIFUGO_ADMIN_PASSWORD=CHANGE_ME
CENTRIFUGO_ADMIN_SECRET=CHANGE_ME

# --- Внешние сервисы ---
AZURACAST_API_KEY=CHANGE_ME
FINDIP_TOKEN=CHANGE_ME

# --- Spotify ---
SPOTIFY_CLIENT_ID=CHANGE_ME
SPOTIFY_CLIENT_SECRET=CHANGE_ME

# --- last.fm (audioscrobbler), у станций разные ключи ---
LASTFM_OMFM_API_KEY=CHANGE_ME
LASTFM_OMFM_API_SECRET=CHANGE_ME
LASTFM_CDP_API_KEY=CHANGE_ME
LASTFM_CDP_API_SECRET=CHANGE_ME

# --- Telegram (скрипт telegram-send-omfm; вызов из .liq сейчас закомментирован) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
